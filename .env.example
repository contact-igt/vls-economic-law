# Server-only. Never prefix these with NEXT_PUBLIC_ — that would ship them to the browser.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Required: registration Google Apps Script web app URL (scripts/google-sheet-webapp.gs).
GOOGLE_SHEET_WEBAPP_URL=
# Recommended: shared secret, also set as the Script property TOKEN in the Apps Script.
GOOGLE_SHEET_TOKEN=
# Optional shared VLS lead backend (best-effort, after the sheet row is written).
NEXT_PUBLIC_API_SERVER=production
NEXT_PUBLIC_PRODUCTION_API_URL=
NEXT_PUBLIC_CLIENT_KEY=vls_law
